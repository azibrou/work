{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --project unit",
    "test:a11y": "playwright test e2e/a11y.spec.js",
    "test:seo": "playwright test e2e/seo.spec.js",
    "lighthouse": "npm run build && lighthouse http://localhost:4173 --only-categories=accessibility,seo --view --chrome-flags=\"--headless\"",
    "test:a11y:aaa": "playwright test e2e/a11y-aaa.spec.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@chromatic-com/storybook": "latest",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "playwright": "latest",
    "prop-types": "latest",
    "storybook": "^10.6.0",
    "vite": "^8.3.0",
    "vitest": "latest"
  }
}
